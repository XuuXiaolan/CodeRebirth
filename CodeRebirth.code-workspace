{
    "folders": [
        {
            "name": "Plugin",
            "path": "Plugin"
        },
        {
            "name": "Asset Sources",
            "path": "AssetSources"
        },
        {
            "name": "GitHub",
            "path": ".github"
        }
    ],
    "settings": {
        "git.openRepositoryInParentFolders": "always",
        "dotnetAcquisitionExtension.allowInvalidPaths": true
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "build",
                "command": "dotnet",
                "type": "process",
                "args": [
                    "build",
                    "${workspaceFolder}/Plugin/CodeRebirth.sln",
                    "/property:GenerateFullPaths=true",
                    "/consoleloggerparameters:NoSummary;ForceNoAlign"
                ],
                "problemMatcher": "$msCompile",
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "publish",
                "command": "dotnet",
                "type": "process",
                "args": [
                    "publish",
                    "${workspaceFolder}/Plugin/CodeRebirth.sln",
                    "/property:GenerateFullPaths=true",
                    "/consoleloggerparameters:NoSummary;ForceNoAlign"
                ],
                "problemMatcher": "$msCompile"
            },
            {
                "label": "watch",
                "command": "dotnet",
                "type": "process",
                "args": [
                    "watch",
                    "run",
                    "--project",
                    "${workspaceFolder}/Plugin/CodeRebirth.sln"
                ],
                "problemMatcher": "$msCompile"
            }
        ]
    }
}